     "lora": ["data/loras/lcm-lora-sdv1-5.safetensors"], "seed": 4, "out": "detailed"},
    {"op": "save", "in": "base", "path": "portrait_512.png"},
    {"op": "save", "in": "detailed", "path": "portrait_1024.png"}
